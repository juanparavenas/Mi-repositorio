# =============================================================================
# CMF Academy · Variables de entorno
#
# Copia este archivo como `.env.local` (Git lo ignora) y completa los valores.
# NUNCA subas valores reales al repositorio ni los pegues en el chat.
#
# · Las variables NEXT_PUBLIC_* llegan al navegador: jamás pongas secretos en ellas.
# · Todas las demás solo existen en el servidor (Vercel) o en el worker
#   (secretos de GitHub Actions).
# · Cada sección indica la fase en que se necesitan sus variables.
# =============================================================================

# --- Sitio (fase 1) -----------------------------------------------------------
# URL pública del sitio. Durante el piloto, el subdominio gratuito de Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (fase 1) --------------------------------------------------------
# Pública: URL del proyecto y clave publicable (respeta RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRETA: clave secreta (omite RLS). Solo servidor y worker.
SUPABASE_SECRET_KEY=
# SECRETA: conexión directa a PostgreSQL para el worker y los respaldos.
SUPABASE_DB_URL=

# --- Seguridad y privacidad (fase 1) ------------------------------------------
# SECRETA: clave para el hash de visitantes (HMAC-SHA256 de IP + agente).
# Se rota a diario derivándola de esta raíz. Generar con: openssl rand -hex 32
VISITOR_HASH_SECRET=

# --- Observabilidad (fase 1) --------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- PubMed y fuentes científicas (fase 3) ------------------------------------
# SECRETA: clave API gratuita de NCBI (10 solicitudes/s).
NCBI_API_KEY=
NCBI_TOOL=cmf-academy
# Correo del proyecto exigido por NCBI, Unpaywall y Crossref.
NCBI_EMAIL=
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=

# --- Inteligencia artificial (fase 4; SOLO con presupuesto aprobado) ----------
# SECRETA. Sin esta clave la IA permanece apagada y el resto funciona.
ANTHROPIC_API_KEY=
# Los límites de uso NO van aquí: viven en la tabla app_settings
# (ai.public_enabled, ai.monthly_budget_usd, ai.daily_quota.*), editables
# por el administrador y auditados.

# --- Embeddings (fase 4; proveedor por decidir, ADR-0014) ---------------------
EMBEDDINGS_PROVIDER=
# SECRETA (si el proveedor la requiere).
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSIONS=1024

# --- Antibots (fase 4) --------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRETA.
TURNSTILE_SECRET_KEY=
